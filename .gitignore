# Python caches from the tools
__pycache__/
*.pyc
*.nbi
*.nbc

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Beads local embedded storage (issues.jsonl + config.yaml stay git-tracked)
.beads/dolt/
.beads/*.lock
.beads/*.pid
.beads/*.sock
.beads/*.log
