{
  "oud-coach-guard": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ../tools/guard/agent_guard.py",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ../tools/guard/agent_guard.py",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../tools/guard/agent_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "read_file|view_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../tools/guard/agent_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
